# =============================================================================
# The World Is Ours — Stock-Footage Acquisition System
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored (PRD §33) — NEVER commit real keys.
# =============================================================================

# --- Stock provider API keys (PRD §3) ---
# Get a Pexels API key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Get a Pixabay API key at: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Vision API key (P2 / OPTIONAL — not used in P0+P1) ---
# Left here so P2 AI scoring can be added without a schema/config change.
VISION_API_KEY=
VISION_API_PROVIDER=openai

# --- Server ---
PORT=3001
HOST=127.0.0.1

# --- FFmpeg / FFprobe (optional override; PRD-locked resolver: config > PATH > bundled) ---
# Absolute path to ffmpeg executable. If unset, the FFmpeg service resolves via
# PATH then the bundled ffmpeg-static npm package.
FFMPEG_BIN_PATH=
FFPROBE_BIN_PATH=

# --- Python engine (audio/video analysis: librosa, numpy, scipy, opencv) ---
# By default the app manages its own interpreter: on first use it creates
# apps/server/python/.venv from a system Python (python/py on PATH) and runs
# `pip install -r apps/server/python/requirements.txt` automatically.
# Set PYTHON_BIN_PATH to use a specific interpreter INSTEAD of the managed
# venv (that interpreter must already have the requirements installed).
PYTHON_BIN_PATH=
# Set to 1 to disable the Python engine entirely (engine features then report
# ENGINE_DISABLED; the built-in TS beat tracker still works without Python).
TWIO_ENGINE_DISABLED=

# --- Output ---
# Root directory for generated footage library (PRD §6). Relative to repo root.
OUTPUT_DIR=THE_WORLD_IS_OURS

# --- Download safety (PRD §34) ---
# Reject downloads larger than this (in megabytes) to avoid runaway bandwidth.
MAX_DOWNLOAD_MB=600

# --- Acquisition tuning ---
# Candidates to fetch per provider per query (PRD §10: up to 30).
CANDIDATES_PER_PROVIDER=30
# Top-N candidates to download per shot (PRD §20: top 5).
TOP_N_PER_SHOT=5
# Near-duplicate pHash Hamming distance threshold (PRD §16 Level 3).
PHASH_HAMMING_THRESHOLD=8
# Search cache TTL in minutes (PRD §30).
SEARCH_CACHE_TTL_MIN=60
