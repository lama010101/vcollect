{
  "name": "the-world-is-ours",
  "version": "0.1.0",
  "private": true,
  "description": "Automated commercial stock-footage acquisition & rights-management system for the 'The World Is Ours' YouTube music video.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n server,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace apps/server",
    "dev:web": "npm run dev --workspace apps/web",
    "test": "npx vitest run && npx tsx --test apps/server/test/*.node.test.ts",
    "test:watch": "vitest",
    "test:server": "npx tsx --test apps/server/test/*.node.test.ts",
    "test:shared": "vitest run",
    "migrate": "npm run migrate --workspace apps/server",
    "seed": "npm run seed --workspace apps/server",
    "acquire": "tsx apps/server/src/cli.ts acquire",
    "acquire:reserve": "tsx apps/server/src/cli.ts acquire:reserve",
    "manifests": "tsx apps/server/src/cli.ts manifests",
    "dashboard": "tsx apps/server/src/cli.ts dashboard"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "vite": "^6.4.4"
  },
  "engines": {
    "node": ">=20"
  }
}
