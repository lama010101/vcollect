{
  "name": "@twio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "start": "node --enable-source-maps dist/index.js"
  },
  "dependencies": {
    "@twio/shared": "*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "@fastify/static": "^8.0.3",
    "@fastify/cors": "^10.0.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
